@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 8D — Admin แก้ไขข่าวสาร

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminNewsEdit\n.vue" as Page
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "accounts\n_urls.py" as URLs
    participant "NewsViewSet\n(views.py)" as View
    participant "News\n(models.py)" as Model
end box

database "Database\n(PostgreSQL)" as DB

== โหลดข้อมูลเดิม (onMounted) ==

Admin -> Page : เข้าหน้าแก้ไขข่าวสาร
activate Page
Page -> Page : onMounted()\nnewsId = route.params.id\n→ fetchNewsData()

Page -> URLs : axios.get(\n"/api/accounts/news/{newsId}/")
activate URLs
URLs -> View : router.urls → news/{pk}/\n→ NewsViewSet.retrieve()
deactivate URLs
activate View

View -> View : get_permissions()\n→ SAFE_METHODS → AllowAny

View -> Model : News.objects.get(pk=pk)
activate Model
Model -> DB : SELECT * FROM accounts_news\nWHERE id = ?
activate DB
DB --> Model : news object
deactivate DB
Model --> View : news
deactivate Model

View --> Page : 200 OK\n{id, title, content, image, ...}
deactivate View

Page -> Page : title.value = res.data.title\ncontent.value = res.data.content\nexistingImageUrl.value = res.data.image
Page --> Admin : แสดงฟอร์มพร้อมข้อมูลเดิม\n(title, content, รูปภาพปัจจุบัน)

== Admin แก้ไขข้อมูลและบันทึก ==

Admin -> Page : แก้ไข title / content\nแนบรูปภาพใหม่ (ถ้าต้องการ)\nกดปุ่ม "บันทึกการแก้ไขข่าวสาร"

Page -> Page : updateNews()\nตรวจสอบ Client-side:\n- title ต้องไม่ว่าง\n- content ต้องไม่ว่าง

opt [ไม่ผ่าน Client-side]
    Page --> Admin : แสดง errorMessage\n"กรุณาใส่หัวข้อและเนื้อหาข่าวให้ครบถ้วน"
end

Page -> Page : สร้าง FormData:\nappend("title", title)\nappend("content", content)\nappend("image", imageFile) [ถ้ามีรูปใหม่]\nlocalStorage.getItem("access")

Page -> URLs : axios.patch(\n"/api/accounts/news/{newsId}/",\nformData,\n{Authorization: Bearer token})
activate URLs
URLs -> View : router.urls → news/{pk}/\n→ NewsViewSet.partial_update()
deactivate URLs
activate View

View -> View : get_permissions()\n→ PATCH → IsAdminUser

View -> View : serializer.is_valid()\n→ ผิด → 400

View -> Model : news.save(...)
activate Model
Model -> DB : UPDATE accounts_news\nSET title=?, content=?,\nimage=? (ถ้ามี), updated_at=now\nWHERE id = ?
activate DB
DB --> Model : updated
deactivate DB
Model --> View : saved
deactivate Model

alt [200 OK — สำเร็จ]
    View --> Page : 200 OK\n{id, title, content,\nimage, updated_at}
    deactivate View

    Page -> Page : successMessage = "แก้ไขข่าวสารสำเร็จ"\nexistingImageUrl = res.data.image\n(ถ้ามีรูปใหม่)\nimageFile = null
    Page --> Admin : แสดงข้อความสำเร็จ\nและรูปภาพที่อัปเดตแล้ว

else [error — ล้มเหลว]
    View --> Page : 4xx error
    deactivate View
    Page --> Admin : แสดง errorMessage\n"เกิดข้อผิดพลาดในการแก้ไขข่าวสาร"
end

deactivate Page

@enduml
