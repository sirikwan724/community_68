@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 20
skinparam BoxPadding 12
skinparam defaultFontSize 13
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 1 — User Login\n(ส่วนที่ 2: สร้าง Token และ Redirect)

actor "ผู้ใช้งาน\n(User)" as User

box "Frontend (Vue)" #EBF5FB
    participant "LoginPage\n.vue" as Page
    participant "router\n/index.js" as Router
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "MyTokenObtain\nPairView\n(views.py)" as View
    participant "MyTokenObtain\nPairSerializer\n(serializers.py)" as Serial
end box

note over Serial : รับ user object มาจากส่วนที่ 1\n(authentication สำเร็จแล้ว)

activate Serial
activate View
activate Page

Serial -> Serial : get_token(user)\n→ super().get_token(user)\n→ เพิ่ม token['role'] = user.role\n→ เพิ่ม token['full_name'] = user.full_name

Serial -> Serial : data.update({\nrole: user.role,\nuser: {\n  id, username, full_name,\n  phone, address,\n  citizen_id, house_owner_name,\n  role\n}})

Serial --> View : {access, refresh,\nrole, user{...}}
deactivate Serial

View --> Page : 200 OK\n{access, refresh, role, user{...}}
deactivate View

Page -> Page : localStorage.setItem("access")\nlocalStorage.setItem("refresh")\nlocalStorage.setItem("role")\nlocalStorage.setItem("user")

Page -> Router : router.push(ตาม role)
activate Router

Router -> Router : beforeEach(to, from, next)\nตรวจ localStorage.access ✅\nตรวจ role ✅\nnext() → ผ่าน

alt [role === "admin"]
    Router --> User : redirect ไป /admin/dashboard
else [role !== "admin"]
    Router --> User : redirect ไป /
end

deactivate Router
deactivate Page

@enduml
