@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 7B (ส่วนที่ 2) — Admin อัปเดตสถานะรายงานปัญหา

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminServiceReports\n.vue" as Page
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "publicservice\n_urls.py" as URLs
    participant "AdminUpdatePublicServiceReportStatusView\n(views.py)" as View
    participant "PublicServiceReport /\nPublicService\n(models.py)" as Model
end box

database "Database\n(PostgreSQL)" as DB

== Admin อัปเดตสถานะ ==

alt [Admin กดรับเรื่อง (pending → processing)]

    Admin -> Page : กดปุ่ม "รับเรื่อง"\n→ updateStatus(id, "processing")
    activate Page

    Page -> URLs : api.patch(\n"/services/reports/{id}/status/",\n{status: "processing"})
    activate URLs
    URLs -> View : route /reports/{pk}/status/\n→ AdminUpdatePublicServiceReportStatusView.patch()
    deactivate URLs
    activate View

    View -> View : ตรวจ status IN\n["resolved","canceled"] → 400
    View -> View : ตรวจ new_status ถูกต้องไหม

    View -> Model : PublicServiceReport.objects.get(pk=pk)
    activate Model
    Model -> DB : SELECT * FROM\npublicservice_publicservicereport\nWHERE id = ?
    activate DB
    DB --> Model : report object
    deactivate DB
    Model --> View : report
    deactivate Model

    View -> View : transaction.atomic()

    View -> Model : report.status = "processing"\nreport.save(update_fields=["status"])
    activate Model
    Model -> DB : UPDATE publicservice_publicservicereport\nSET status="processing"\nWHERE id = ?
    activate DB
    DB --> Model : updated
    deactivate DB
    Model --> View : saved
    deactivate Model

    View -> Model : service.status = "maintenance"\nservice.save(update_fields=["status"])
    activate Model
    Model -> DB : UPDATE publicservice_publicservice\nSET status="maintenance"\nWHERE id = ?
    activate DB
    DB --> Model : updated
    deactivate DB
    Model --> View : saved
    deactivate Model

    View --> Page : 200 OK {report data}
    deactivate View

    Page -> Page : fetchReports()\nupdate selectedReport
    Page --> Admin : ตารางและ Modal\nอัปเดตสถานะ "กำลังดำเนินการ"

else [Admin กดดำเนินการเสร็จสิ้น (processing → resolved)]

    Admin -> Page : กดปุ่ม "ดำเนินการเสร็จสิ้น"\n→ updateStatus(id, "resolved")
    activate Page

    Page -> URLs : api.patch(\n"/services/reports/{id}/status/",\n{status: "resolved"})
    activate URLs
    URLs -> View : route /reports/{pk}/status/\n→ AdminUpdatePublicServiceReportStatusView.patch()
    deactivate URLs
    activate View

    View -> View : ตรวจ status IN\n["resolved","canceled"] → 400

    View -> Model : PublicServiceReport.objects.get(pk=pk)
    activate Model
    Model -> DB : SELECT * FROM\npublicservice_publicservicereport\nWHERE id = ?
    activate DB
    DB --> Model : report object
    deactivate DB
    Model --> View : report
    deactivate Model

    View -> View : transaction.atomic()

    View -> Model : report.status = "resolved"\nreport.save(update_fields=["status"])
    activate Model
    Model -> DB : UPDATE publicservice_publicservicereport\nSET status="resolved"\nWHERE id = ?
    activate DB
    DB --> Model : updated
    deactivate DB
    Model --> View : saved
    deactivate Model

    View -> DB : SELECT EXISTS FROM\npublicservice_publicservicereport\nWHERE service=? AND status\nNOT IN ("resolved","canceled")
    activate DB
    DB --> View : has_open_reports
    deactivate DB

    alt [ยังมีรายงานค้างอยู่]
        View -> Model : service.status = "maintenance"\nservice.save()
        activate Model
        Model -> DB : UPDATE publicservice_publicservice\nSET status="maintenance"\nWHERE id = ?
        activate DB
        DB --> Model : updated
        deactivate DB
        Model --> View : saved
        deactivate Model
    else [ไม่มีรายงานค้างแล้ว]
        View -> Model : service.status = "normal"\nservice.save()
        activate Model
        Model -> DB : UPDATE publicservice_publicservice\nSET status="normal"\nWHERE id = ?
        activate DB
        DB --> Model : updated
        deactivate DB
        Model --> View : saved
        deactivate Model
    end

    View --> Page : 200 OK {report data}
    deactivate View

    Page -> Page : fetchReports()\nupdate selectedReport
    Page --> Admin : ตารางและ Modal\nอัปเดตสถานะ "เสร็จสิ้น"

else [Admin กดรายงานไม่ถูกต้อง (→ canceled)]

    Admin -> Page : กดปุ่ม "รายงานไม่ถูกต้อง"\n→ updateStatus(id, "canceled")
    activate Page

    Page -> URLs : api.patch(\n"/services/reports/{id}/status/",\n{status: "canceled"})
    activate URLs
    URLs -> View : route /reports/{pk}/status/\n→ AdminUpdatePublicServiceReportStatusView.patch()
    deactivate URLs
    activate View

    View -> View : ตรวจ status IN\n["resolved","canceled"] → 400

    View -> Model : PublicServiceReport.objects.get(pk=pk)
    activate Model
    Model -> DB : SELECT * FROM\npublicservice_publicservicereport\nWHERE id = ?
    activate DB
    DB --> Model : report object
    deactivate DB
    Model --> View : report
    deactivate Model

    View -> View : transaction.atomic()

    View -> Model : report.status = "canceled"\nreport.save(update_fields=["status"])
    activate Model
    Model -> DB : UPDATE publicservice_publicservicereport\nSET status="canceled"\nWHERE id = ?
    activate DB
    DB --> Model : updated
    deactivate DB
    Model --> View : saved
    deactivate Model

    View --> Page : 200 OK {report data}
    deactivate View

    Page -> Page : fetchReports()\nupdate selectedReport
    Page --> Admin : ตารางและ Modal\nอัปเดตสถานะ "รายงานไม่ถูกต้อง"

end

deactivate Page

@enduml
