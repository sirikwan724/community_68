@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 3A — User ส่งคำร้อง / รายงานปัญหา

actor "ผู้ใช้งาน\n(User)" as User

box "Frontend (Vue)" #EBF5FB
    participant "ReportForm\n.vue" as Page
    participant "router\n/index.js" as Router
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "reports\n/urls.py" as URLs
    participant "create_report\n(views.py)" as View
    participant "ReportSerializer\n(serializers.py)" as Serial
    participant "Report\n(models.py)" as RepModel
end box

database "Database\n(PostgreSQL)" as DB

== User กรอกแบบฟอร์มและส่งคำร้อง ==

User -> Page : กรอกข้อมูลและกดปุ่ม\n"ส่งคำร้อง"
activate Page

Page -> Page : submitForm()\nloading = true\nล้าง successMessage / errorMessage

Page -> Page : สร้าง FormData\ncategory (หรือ customCategory)\ndescription, area\nimage (ถ้ามี)

Page -> URLs : axios.post(\n"/api/reports/create/",\nformData,\n{headers: {Authorization: Bearer token,\nContent-Type: multipart/form-data}})
activate URLs

URLs -> View : route /create/\n→ create_report(request)
deactivate URLs
activate View

View -> View : data = request.data.copy()\ndata["user"] = request.user.id\ndata["fullname"] = request.user.full_name\ndata["phone"] = request.user.phone

View -> Serial : ReportSerializer(data=data)
activate Serial

Serial -> Serial : is_valid()

alt [ข้อมูลไม่ผ่าน validation]
    Serial --> View : errors
    View --> Page : 400 Bad Request\n{errors}
    Page --> User : แสดง error\n"เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง"
else [ข้อมูลผ่านทั้งหมด]
    Serial -> RepModel : serializer.save(\nuser=request.user)
    activate RepModel
    RepModel -> DB : INSERT INTO reports_report\n(user_id, fullname, phone,\ncategory, description, area,\nimage, status="pending")
    activate DB
    DB --> RepModel : report.id
    deactivate DB
    RepModel --> Serial : report object
    deactivate RepModel

    Serial --> View : serializer.data
    deactivate Serial

    View --> Page : 201 Created\n{id, category, description,\narea, status="pending", ...}
    deactivate View

    Page -> Page : successMessage =\n"ส่งคำร้องเรียบร้อยแล้ว!\nแอดมินจะตรวจสอบโดยเร็วที่สุด"\nsetTimeout(1500ms)

    Page -> Router : router.push("/my-history")
    activate Router
    Router --> User : redirect ไปหน้าประวัติคำร้อง
    deactivate Router
end

deactivate Page

@enduml
