@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 3B (ส่วนที่ 3) — ปิด Modal และ Reload ตาราง

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminReports\n.vue" as Page
    participant "ReportDetail\nModal.vue" as Modal
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "reports\n/urls.py" as URLs
    participant "admin_list_reports\n(views.py)" as View
    participant "Report\n(models.py)" as RepModel
end box

database "Database\n(PostgreSQL)" as DB

== ปิด Modal และ Reload ตาราง (ทุกกรณี) ==

activate Modal

Modal -> Modal : alert "อัปเดตสำเร็จ"

Modal -> Page : emit("updated")
activate Page
Page -> Page : loadReports()

Modal -> Page : emit("close")
Page -> Page : selectedReport = null
deactivate Modal

Page -> URLs : api.get("/reports/admin-all/")
activate URLs

URLs -> View : route /admin-all/\n→ admin_list_reports()
deactivate URLs
activate View

View -> View : ตรวจ role != "admin" → 403

View -> RepModel : Report.objects.all()\n.order_by("-created_at")
activate RepModel

RepModel -> DB : SELECT * FROM reports_report\nORDER BY created_at DESC
activate DB
DB --> RepModel : updated list
deactivate DB

RepModel --> View : queryset
deactivate RepModel

View --> Page : 200 OK\n[{id, category, area,\nuser_data, status,\ncreated_at, notes, ...}]
deactivate View

Page --> Admin : ตารางอัปเดตสถานะใหม่
deactivate Page

@enduml
