@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 5B (ส่วนที่ 2) — Admin เลือกดำเนินการนัดหมาย

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminAppointment\nList.vue" as Page
    participant "AppointmentDetail\nModal.vue" as Modal
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "appointment\n_urls.py" as URLs
    participant "approve_appointment /\nreject_appointment\n(views.py)" as View
    participant "Appointment\n(models.py)" as ApptModel
end box

database "Database\n(PostgreSQL)" as DB

== Admin เลือกการดำเนินการ ==

alt [Admin กดปุ่ม "อนุมัติ" ในตาราง (status = pending)]

    Admin -> Page : กดปุ่ม "อนุมัติ"\n→ approve(item.id)
    activate Page

    Page -> Page : confirm(\n"ยืนยันการอนุมัตินัดหมายนี้หรือไม่?")

    Page -> URLs : axios.patch(\n"/api/appointments/{id}/approve/",\n{}, {headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /{pk}/approve/\n→ approve_appointment()
    deactivate URLs
    activate View

    View -> View : ตรวจ role != "admin" → 403

    View -> ApptModel : Appointment.objects.get(pk=pk)
    activate ApptModel
    ApptModel -> DB : SELECT * FROM reports_appointment\nWHERE id = ?
    activate DB
    DB --> ApptModel : appointment object
    deactivate DB
    ApptModel --> View : appointment
    deactivate ApptModel

    View -> ApptModel : appointment.status = "approved"\nappointment.save()
    activate ApptModel
    ApptModel -> DB : UPDATE reports_appointment\nSET status="approved"\nWHERE id = ?
    activate DB
    DB --> ApptModel : updated
    deactivate DB
    ApptModel --> View : saved
    deactivate ApptModel

    View --> Page : 200 OK\n{"message": "อนุมัตินัดหมายแล้ว"}
    deactivate View

    Page -> Page : alert "อนุมัติสำเร็จ"\nmodalOpen = false\nloadAppointments()
    Page --> Admin : ตารางอัปเดตสถานะ\n"อนุมัติแล้ว"

else [Admin กดปุ่ม "ปฏิเสธ" ในตาราง (status = pending)]

    Admin -> Page : กดปุ่ม "ปฏิเสธ"\n→ openDetailWithReject(item)

    Page -> Modal : เปิด Modal\nส่ง item object\nautoReject = true
    activate Modal

    Modal -> Modal : watch(autoReject = true)\n→ showRejectForm = true\nแสดงช่องกรอก rejectNote ทันที

    Admin -> Modal : กรอก rejectNote\nกดปุ่ม "ยืนยันการปฏิเสธ"

    Modal -> Modal : ตรวจ rejectNote ว่างไหม\n→ alert "กรุณาระบุเหตุผล"

    Modal -> Page : emit("reject",\n{id: appointment.id,\nnote: rejectNote})
    deactivate Modal

    Page -> URLs : axios.patch(\n"/api/appointments/{id}/reject/",\n{note},\n{headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /{pk}/reject/\n→ reject_appointment()
    deactivate URLs
    activate View

    View -> View : ตรวจ role != "admin" → 403

    View -> ApptModel : Appointment.objects.get(pk=pk)
    activate ApptModel
    ApptModel -> DB : SELECT * FROM reports_appointment\nWHERE id = ?
    activate DB
    DB --> ApptModel : appointment object
    deactivate DB
    ApptModel --> View : appointment
    deactivate ApptModel

    View -> View : ตรวจ note ว่างไหม\n→ 400 "กรุณาระบุเหตุผลการปฏิเสธ"

    View -> ApptModel : appointment.status = "rejected"\nappointment.admin_note = note\nappointment.save()
    activate ApptModel
    ApptModel -> DB : UPDATE reports_appointment\nSET status="rejected",\nadmin_note=note\nWHERE id = ?
    activate DB
    DB --> ApptModel : updated
    deactivate DB
    ApptModel --> View : saved
    deactivate ApptModel

    View --> Page : 200 OK\n{"message": "ปฏิเสธนัดหมายแล้ว"}
    deactivate View

    Page -> Page : alert "ยกเลิกสำเร็จ"\nmodalOpen = false\nopenWithReject = false\nloadAppointments()
    Page --> Admin : ตารางอัปเดตสถานะ\n"ถูกยกเลิก"

end

deactivate Page

@enduml
