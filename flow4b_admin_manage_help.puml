@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 4B — Admin จัดการคำขอความอนุเคราะห์

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminRequest\nHelp.vue" as Page
    participant "RequestHelp\nDetailModal.vue" as Modal
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "reports\n/urls.py" as URLs
    participant "admin_request_help /\nrequest_help_approve /\nrequest_help_reject\n(views.py)" as View
    participant "RequestHelp\n(models.py)" as HelpModel
end box

database "Database\n(PostgreSQL)" as DB

== โหลดรายการคำขอ (onMounted) ==

Admin -> Page : เข้าหน้าจัดการ\nคำขอความอนุเคราะห์
activate Page

Page -> Page : onMounted()\n→ loadData()

Page -> URLs : axios.get(\n"/api/reports/help/admin/",\n{headers: {Authorization: Bearer token}})
activate URLs

URLs -> View : route /help/admin/\n→ admin_request_help()
deactivate URLs
activate View

View -> View : ตรวจ role != "admin" → 403

View -> HelpModel : RequestHelp.objects.all()\n.order_by("-created_at")
activate HelpModel
HelpModel -> DB : SELECT * FROM reports_requesthelp\nORDER BY created_at DESC
activate DB
DB --> HelpModel : list of requests
deactivate DB
HelpModel --> View : queryset
deactivate HelpModel

View --> Page : 200 OK\n[{id, request_type,\nstart_datetime, end_datetime,\narea, status, user_data,...}]
deactivate View

Page --> Admin : แสดงตารางรายการคำขอ\n(pending / approved / rejected)

== Admin เปิดดูรายละเอียด ==

Admin -> Page : คลิก "ดูรายละเอียด"\n→ openDetail(item)

Page -> Modal : เปิด Modal\nส่ง item object\n(modalOpen = true)
activate Modal

Modal --> Admin : แสดงรายละเอียดคำขอ\n(request_type, datetime, area,\ndetail, file, status, user_data)

== Admin เลือกการดำเนินการ ==

alt [Admin กดอนุมัติ (status = pending)]

    Admin -> Modal : กดปุ่ม "✔ อนุมัติ"
    Modal -> Page : emit("approve", data.id)
    deactivate Modal
    activate Page

    Page -> URLs : axios.patch(\n"/api/reports/help/{id}/approve/",\n{}, {headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /help/{pk}/approve/\n→ request_help_approve()
    deactivate URLs
    activate View

    View -> View : ตรวจ role != "admin" → 403
    View -> HelpModel : RequestHelp.objects.get(pk=pk)
    activate HelpModel
    HelpModel -> DB : SELECT * FROM reports_requesthelp\nWHERE id = ?
    activate DB
    DB --> HelpModel : help object
    deactivate DB
    HelpModel --> View : help_obj
    deactivate HelpModel

    View -> HelpModel : help_obj.status = "approved"\nhelp_obj.save()
    activate HelpModel
    HelpModel -> DB : UPDATE reports_requesthelp\nSET status="approved"\nWHERE id = ?
    activate DB
    DB --> HelpModel : updated
    deactivate DB
    HelpModel --> View : saved
    deactivate HelpModel

    View --> Page : 200 OK\n{"message": "อนุมัติแล้ว"}
    deactivate View

    Page -> Page : modalOpen = false\nloadData()
    Page --> Admin : ตารางอัปเดตสถานะ "อนุมัติแล้ว"

else [Admin กดปฏิเสธ (status = pending)]

    Admin -> Modal : กดปุ่ม "❌ ปฏิเสธ"
    activate Modal
    Modal -> Modal : rejectMode = true\nแสดงช่องกรอก rejectReason

    Admin -> Modal : กรอก rejectReason\nกดปุ่ม "ส่งเหตุผลปฏิเสธ"
    Modal -> Page : emit("reject",\n{id: data.id,\nreason: rejectReason})
    deactivate Modal

    Page -> URLs : axios.patch(\n"/api/reports/help/{id}/reject/",\n{reason},\n{headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /help/{pk}/reject/\n→ request_help_reject()
    deactivate URLs
    activate View

    View -> View : ตรวจ role != "admin" → 403
    View -> HelpModel : RequestHelp.objects.get(pk=pk)
    activate HelpModel
    HelpModel -> DB : SELECT * FROM reports_requesthelp\nWHERE id = ?
    activate DB
    DB --> HelpModel : help object
    deactivate DB
    HelpModel --> View : help_obj
    deactivate HelpModel

    View -> View : ตรวจ status in\n["rejected","done","canceled"]\n→ 400

    View -> HelpModel : help_obj.status = "rejected"\nhelp_obj.reject_reason = reason\nhelp_obj.save()
    activate HelpModel
    HelpModel -> DB : UPDATE reports_requesthelp\nSET status="rejected",\nreject_reason=reason\nWHERE id = ?
    activate DB
    DB --> HelpModel : updated
    deactivate DB
    HelpModel --> View : saved
    deactivate HelpModel

    View --> Page : 200 OK\n{"message": "ปฏิเสธคำขอแล้ว"}
    deactivate View

    Page -> Page : modalOpen = false\nloadData()
    Page --> Admin : ตารางอัปเดตสถานะ "ปฏิเสธ"

end

deactivate Page

@enduml
