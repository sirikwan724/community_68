@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 7A — User แจ้งปัญหาบริการสาธารณะ

actor "ผู้ใช้งาน\n(User)" as User

box "Frontend (Vue)" #EBF5FB
    participant "ServiceReportForm\n.vue" as Page
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "publicservice\n_urls.py" as URLs
    participant "PublicServiceReportCreateView\n(views.py)" as View
    participant "PublicServiceReport\n(models.py)" as Model
end box

database "Database\n(PostgreSQL)" as DB

== User กรอกแบบฟอร์มแจ้งปัญหา ==

User -> Page : เข้าหน้าฟอร์ม\nแจ้งปัญหาบริการสาธารณะ
activate Page
Page -> Page : serviceId =\nroute.params.serviceId

User -> Page : กรอก title, description\nแนบรูป (ไม่บังคับ)\nกดปุ่ม "ส่งรายงาน"

Page -> Page : submitForm()\nตรวจสอบ Client-side:\n- title ต้องไม่ว่าง\n- description ต้องไม่ว่าง

opt [ไม่ผ่าน Client-side]
    Page --> User : แสดง errorMessage\n"กรุณากรอกหัวข้อและรายละเอียดให้ครบ"
end

Page -> Page : สร้าง FormData:\nappend("service", serviceId)\nappend("title", title)\nappend("description", description)\nappend("image", imageFile) [ถ้ามี]

Page -> URLs : api.post(\n"/services/reports/create/",\nformData,\n{headers: {"Content-Type":\nmultipart/form-data}})
activate URLs
URLs -> View : route /reports/create/\n→ PublicServiceReportCreateView.post()
deactivate URLs
activate View

View -> View : serializer.is_valid()\n→ ผิด → 400

View -> Model : serializer.save(\nuser=request.user)
activate Model
Model -> DB : INSERT INTO\npublicservice_publicservicereport\n(user, service, title,\ndescription, image,\nstatus="pending")
activate DB
DB --> Model : report.id
deactivate DB
Model --> View : report object
deactivate Model

alt [201 Created — สำเร็จ]
    View --> Page : 201 Created\n{id, title, status="pending",...}
    deactivate View
    Page --> User : แสดง successMessage\n"ส่งรายงานปัญหาตู้บริการ\nเรียบร้อยแล้ว!"
    Page -> Page : setTimeout(1000ms)\n→ router.push(\n"/public-services/{serviceId}")
    Page --> User : redirect ไปหน้ารายละเอียด\nบริการสาธารณะ
else [error — ล้มเหลว]
    View --> Page : 4xx error
    deactivate View
    Page --> User : แสดง errorMessage\n"เกิดข้อผิดพลาด\nกรุณาลองใหม่อีกครั้ง"
end

deactivate Page

@enduml
