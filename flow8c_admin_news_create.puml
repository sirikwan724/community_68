@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 8C — Admin สร้างข่าวสารใหม่

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminNewsCreate\n.vue" as Page
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "accounts\n_urls.py" as URLs
    participant "NewsViewSet\n(views.py)" as View
    participant "News\n(models.py)" as Model
end box

database "Database\n(PostgreSQL)" as DB

== Admin กรอกข้อมูลและสร้างข่าวสาร ==

Admin -> Page : เข้าหน้าสร้างข่าวสาร
activate Page

Admin -> Page : กรอก title, content\nแนบรูปภาพ (ถ้ามี)\nกดปุ่ม "ประกาศข่าวสาร"

Page -> Page : submitNews()\nตรวจสอบ Client-side:\n- title ต้องไม่ว่าง\n- content ต้องไม่ว่าง

opt [ไม่ผ่าน Client-side]
    Page --> Admin : แสดง errorMessage\n"กรุณาใส่หัวข้อและเนื้อหาข่าวให้ครบถ้วน"
end

Page -> Page : สร้าง FormData:\nappend("title", title)\nappend("content", content)\nappend("image", imageFile) [ถ้ามี]\nlocalStorage.getItem("access")

Page -> URLs : axios.post(\n"/api/accounts/news/",\nformData,\n{Authorization: Bearer token})
activate URLs
URLs -> View : router.urls → news/\n→ NewsViewSet.create()
deactivate URLs
activate View

View -> View : get_permissions()\n→ POST → IsAdminUser

View -> View : serializer.is_valid()\n→ ผิด → 400

View -> View : perform_create(serializer)\n→ serializer.save(\nauthor=request.user)

View -> Model : News.objects.create(...)
activate Model
Model -> DB : INSERT INTO accounts_news\n(title, content, image,\nauthor_id, created_at)
activate DB
DB --> Model : news.id
deactivate DB
Model --> View : news object
deactivate Model

alt [201 Created — สำเร็จ]
    View --> Page : 201 Created\n{id, title, content,\nimage, created_at}
    deactivate View

    Page -> Page : successMessage = "สร้างข่าวสารสำเร็จ"\nเคลียร์ฟอร์ม (title, content, image)
    Page --> Admin : แสดงข้อความสำเร็จ
    Page -> Page : setTimeout(3000ms)\n→ router.push("/admin/news-list")
    Page --> Admin : redirect ไปหน้าตารางข่าวสาร

else [error — ล้มเหลว]
    View --> Page : 4xx error
    deactivate View
    Page --> Admin : แสดง errorMessage\n"เกิดข้อผิดพลาดในการสร้างข่าวสาร"
end

deactivate Page

@enduml
