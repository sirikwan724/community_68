@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 6A (ส่วนที่ 2) — User กรอกข้อมูลและส่งคำขอยืม/จอง

actor "ผู้ใช้งาน\n(User)" as User

box "Frontend (Vue)" #EBF5FB
    participant "BorrowForm\n.vue" as Page
    participant "BorrowService\n(borrow.service.js)" as Service
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "borrow\n_urls.py" as URLs
    participant "CreateBorrowRequestView\n(views.py)" as View
    participant "BorrowRequest\n(models.py)" as Model
end box

database "Database\n(PostgreSQL)" as DB

== User กรอกข้อมูลและส่งคำขอ ==

User -> Page : กรอกข้อมูลครบและกดปุ่ม\n"ยืนยันการขอยืม"
activate Page

Page -> Page : submit()\nตรวจสอบ Client-side:\n- borrow_type / items หรือ location\n- start/end/pickup/\nexpected_return ต้องไม่ว่าง

opt [ไม่ผ่าน Client-side]
    Page --> User : alert ข้อความ error
end

Page -> Page : สร้าง payload:\n{borrow_type, items[],\nlocation, start_datetime,\nend_datetime, pickup_datetime,\nexpected_return_datetime, purpose}

Page -> Service : BorrowService.createRequest(payload)
activate Service
Service -> URLs : POST /borrow/requests/
activate URLs
URLs -> View : route /requests/\n→ CreateBorrowRequestView.post()
deactivate URLs
activate View

View -> View : serializer.is_valid()\n→ ผิด → 400

View -> Model : serializer.save(\nuser=request.user)
activate Model
Model -> DB : INSERT INTO borrow_borrowrequest\n(user, borrow_type,\nstatus="pending",...)
activate DB
DB --> Model : request.id
deactivate DB
Model --> View : borrow_request
deactivate Model

View -> View : perform_create()\nตรวจสอบ conflict/stock

alt [borrow_type="LOCATION": มี conflict]

    View -> DB : SELECT * FROM borrow_borrowrequest\nWHERE location=? AND status IN\n("pending","approved")\nAND datetime overlap
    activate DB
    DB --> View : conflict rows
    deactivate DB
    View --> Service : 400\n"สถานที่ไม่ว่าง"
    deactivate View
    Service --> Page : error
    deactivate Service
    Page --> User : alert error

else [borrow_type="ITEM": stock ไม่พอ]

    View -> DB : SELECT stock FROM borrow_item\nWHERE id IN items
    activate DB
    DB --> View : stock values
    deactivate DB
    View --> Service : 400\n"สินค้าไม่เพียงพอ"
    deactivate View
    Service --> Page : error
    deactivate Service
    Page --> User : alert error

else [ผ่านการตรวจสอบทั้งหมด]

    View --> Service : 201 Created\n{id, borrow_type,\nstatus="pending",...}
    deactivate View
    Service --> Page : res
    deactivate Service
    Page --> User : alert "ส่งคำขอสำเร็จ"
    Page -> Page : router.push(\n{path:"/my-history",\nquery:{tab:"borrows"}})
    Page --> User : redirect ไปหน้าประวัติ\n(แท็บ borrows)

end

deactivate Page

@enduml
