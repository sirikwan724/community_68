@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 3B (ส่วนที่ 2) — Admin เลือกดำเนินการกับรายงาน

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "AdminReports\n.vue" as Page
    participant "ReportDetail\nModal.vue" as Modal
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "reports\n/urls.py" as URLs
    participant "report_accept /\nreport_add_note /\nreport_done /\nreport_rollback\n(views.py)" as View
    participant "Report\n(models.py)" as RepModel
    participant "ReportNote\n(models.py)" as NoteModel
end box

database "Database\n(PostgreSQL)" as DB

== Admin เลือกการดำเนินการ ==

alt [รับเรื่อง (status = pending)]

    Admin -> Modal : เลือก "รับเรื่อง"\nกรอก noteText → บันทึก
    activate Modal

    Modal -> URLs : axios.patch(\n"/api/reports/{id}/accept/",\n{}, {headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /{pk}/accept/\n→ report_accept()
    deactivate URLs
    activate View

    View -> RepModel : report.status = "processing"\nreport.save()
    activate RepModel
    RepModel -> DB : UPDATE reports_report\nSET status="processing"\nWHERE id = ?
    activate DB
    DB --> RepModel : updated
    deactivate DB
    RepModel --> View : saved
    deactivate RepModel

    View --> Modal : 200 OK\n{"message": "รับเรื่องแล้ว"}
    deactivate View

else [เพิ่มบันทึก (status = processing)]

    Admin -> Modal : เลือก "เพิ่มบันทึก"\nกรอก noteText → บันทึก

    Modal -> URLs : axios.post(\n"/api/reports/{id}/add-note/",\n{message: noteText},\n{headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /{pk}/add-note/\n→ report_add_note()
    deactivate URLs
    activate View

    View -> NoteModel : ReportNote.objects.create(\nreport=report, text=message)
    activate NoteModel
    NoteModel -> DB : INSERT INTO reports_reportnote\n(report_id, text)
    activate DB
    DB --> NoteModel : note.id
    deactivate DB
    NoteModel --> View : note object
    deactivate NoteModel

    View --> Modal : 200 OK\n{"message": "เพิ่มโน้ตแล้ว",\n"note": {...}}
    deactivate View

else [ดำเนินการเสร็จสิ้น (status = processing)]

    Admin -> Modal : เลือก "ดำเนินการเสร็จสิ้น"\nกรอก noteText → บันทึก

    Modal -> URLs : axios.patch(\n"/api/reports/{id}/done/",\n{message: noteText},\n{headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /{pk}/done/\n→ report_done()
    deactivate URLs
    activate View

    View -> RepModel : report.status = "resolved"\nreport.save()
    activate RepModel
    RepModel -> DB : UPDATE reports_report\nSET status="resolved"\nWHERE id = ?
    activate DB
    DB --> RepModel : updated
    deactivate DB
    RepModel --> View : saved
    deactivate RepModel

    View -> NoteModel : ReportNote.objects.create(\nreport=report, text=message)
    activate NoteModel
    NoteModel -> DB : INSERT INTO reports_reportnote\n(report_id, text)
    activate DB
    DB --> NoteModel : note.id
    deactivate DB
    NoteModel --> View : note object
    deactivate NoteModel

    View --> Modal : 200 OK\n{"message": "อัปเดตสถานะแล้วเสร็จ"}
    deactivate View

else [ย้อนกลับสถานะ (status = resolved)]

    Admin -> Modal : เลือก "ย้อนกลับสถานะ"\n→ บันทึก

    Modal -> URLs : axios.patch(\n"/api/reports/{id}/rollback/",\n{}, {headers: {Authorization: Bearer token}})
    activate URLs
    URLs -> View : route /{pk}/rollback/\n→ report_rollback()
    deactivate URLs
    activate View

    View -> RepModel : report.status = "processing"\nreport.save()
    activate RepModel
    RepModel -> DB : UPDATE reports_report\nSET status="processing"\nWHERE id = ?
    activate DB
    DB --> RepModel : updated
    deactivate DB
    RepModel --> View : saved
    deactivate RepModel

    View --> Modal : 200 OK\n{"message": "ย้อนกลับสถานะเป็น\nกำลังดำเนินการ"}
    deactivate View

end

== ปิด Modal และ Reload ตาราง ==

Modal -> Modal : alert "อัปเดตสำเร็จ"
Modal -> Page : emit("updated")\n→ loadReports()
Modal -> Page : emit("close")\n→ selectedReport = null
deactivate Modal

activate Page
Page -> URLs : api.get("/reports/admin-all/")
activate URLs
URLs -> View : route /admin-all/\n→ admin_list_reports()
activate View
View -> RepModel : Report.objects.all()
activate RepModel
RepModel -> DB : SELECT * FROM reports_report
activate DB
DB --> RepModel : updated list
deactivate DB
RepModel --> View : queryset
deactivate RepModel
View --> Page : 200 OK [updated list]
deactivate View
deactivate URLs
Page --> Admin : ตารางอัปเดตสถานะใหม่
deactivate Page

@enduml
