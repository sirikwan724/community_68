@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 5A — User จองนัดหมาย

actor "ผู้ใช้งาน\n(User)" as User

box "Frontend (Vue)" #EBF5FB
    participant "AppointmentForm\n.vue" as Page
    participant "router\n/index.js" as Router
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "appointment\n_urls.py" as URLs
    participant "create_appointment\n(views.py)" as View
    participant "Appointment\nSerializer\n(serializers.py)" as Serial
    participant "Appointment\n(models.py)" as ApptModel
end box

database "Database\n(PostgreSQL)" as DB

== User กรอกแบบฟอร์มและส่งคำขอนัดหมาย ==

User -> Page : กรอกข้อมูลและกดปุ่ม\n"ยืนยันการนัดหมาย"
activate Page

Page -> Page : submitForm()\nตรวจสอบ Client-side\n1) date/start_time/end_time ต้องไม่ว่าง\n2) date >= วันนี้\n3) ถ้า date = วันนี้ → start_time >= เวลาปัจจุบัน\n4) end_time > start_time

opt [ไม่ผ่าน Client-side]
    Page --> User : alert ข้อความ error\n(วันที่/เวลาไม่ถูกต้อง)
end

Page -> URLs : axios.post(\n"/api/appointments/create/",\n{meet_with, meeting_place,\ndate, start_time,\nend_time, reason},\n{headers: {Authorization: Bearer token,\nContent-Type: application/json}})
activate URLs

URLs -> View : route /create/\n→ create_appointment(request)
deactivate URLs
activate View

View -> View : data = request.data.copy()\ndata["user"] = request.user.id

View -> View : ตรวจสอบ Backend:\nparse date / start_time / end_time\n→ ผิดรูปแบบ → 400

View -> View : ตรวจ date < today → 400\nตรวจ date = today และ start_time < now → 400\nตรวจ end_time <= start_time → 400

View -> Serial : AppointmentSerializer(data=data)
activate Serial

Serial -> Serial : is_valid()

alt [ข้อมูลไม่ผ่าน validation]
    Serial --> View : errors
    View --> Page : 400 Bad Request {errors}
    Page --> User : alert\n"เกิดข้อผิดพลาด\nไม่สามารถบันทึกนัดหมายได้"
else [ข้อมูลผ่านทั้งหมด]
    Serial -> ApptModel : serializer.save(\nuser=request.user)
    activate ApptModel
    ApptModel -> DB : INSERT INTO reports_appointment\n(user_id, meet_with,\nmeeting_place, date,\nstart_time, end_time,\nreason, status="pending")
    activate DB
    DB --> ApptModel : appointment.id
    deactivate DB
    ApptModel --> Serial : appointment object
    deactivate ApptModel

    Serial --> View : serializer.data
    deactivate Serial

    View --> Page : 201 Created\n{id, meet_with, date,\nstart_time, end_time,\nstatus="pending",...}
    deactivate View

    Page --> User : alert "สร้างนัดหมายสำเร็จ"

    Page -> Router : router.push("/my-history")
    activate Router
    Router --> User : redirect ไปหน้าประวัติ
    deactivate Router
end

deactivate Page

@enduml
