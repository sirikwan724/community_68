@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 2B — Admin Approve / Reject Registration Request

actor "Admin" as Admin

box "Frontend (Vue)" #EBF5FB
    participant "UserApprovePage\n.vue" as Page
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "accounts\n/urls.py" as URLs
    participant "request_all /\nrequest_approve /\nrequest_reject\n(views.py)" as View
    participant "RegistrationRequest\n(models.py)" as RegModel
    participant "User\n(models.py)" as UserModel
end box

database "Database\n(PostgreSQL)" as DB

== โหลดรายการคำขอ (onMounted) ==

Admin -> Page : เข้าหน้า\n/admin/users/approve
activate Page

Page -> Page : onMounted()\n→ fetchRequests()

Page -> Page : ตรวจ localStorage.access\nมี token ไหม?

opt [ไม่มี token]
    Page --> Admin : redirect ไป /login
end

Page -> URLs : axios.get(\n"/api/accounts/admin/requests/all/",\n{headers: {Authorization: Bearer token},\nparams: {year, month, status}})
activate URLs

URLs -> View : route /admin/requests/all/\n→ request_all()
deactivate URLs
activate View

View -> View : ตรวจ request.user.role != "admin"

alt [ไม่ใช่ Admin]
    View --> Page : 403 Forbidden\n{"detail": "คุณไม่มีสิทธิ์เข้าถึงข้อมูลนี้"}
    Page --> Admin : แสดง error
else [เป็น Admin]
    View -> RegModel : RegistrationRequest\n.objects.all()\n.order_by("-created_at")
    activate RegModel
    RegModel -> DB : SELECT * FROM\naccounts_registrationrequest\nORDER BY created_at DESC
    activate DB
    DB --> RegModel : list of requests
    deactivate DB
    RegModel --> View : queryset
    deactivate RegModel

    View --> Page : 200 OK\n[{id, username, full_name,\nphone, address, citizen_id,\nbirth_date, status, ...}]
    deactivate View

    Page --> Admin : แสดงตารางรายการคำขอ\n(pending / approved / rejected)
end

== Admin พิจารณาคำขอ ==

Admin -> Page : คลิกชื่อ → openModal(user)\nดูรายละเอียด

alt [Admin กดอนุมัติ]

    Admin -> Page : กดปุ่ม "✓ อนุมัติ"\n→ approveUser(user)
    Page -> Page : confirm("ยืนยันการอนุมัติ?")

    Page -> URLs : axios.post(\n"/api/accounts/admin/requests/{id}/approve/",\n{}, {headers: {Authorization: Bearer token}})
    activate URLs

    URLs -> View : route /requests/{pk}/approve/\n→ request_approve()
    deactivate URLs
    activate View

    View -> View : ตรวจ role != "admin" → 403
    View -> RegModel : RegistrationRequest\n.objects.get(pk=pk)
    activate RegModel
    RegModel -> DB : SELECT * FROM\naccounts_registrationrequest\nWHERE id = ?
    activate DB
    DB --> RegModel : request object
    deactivate DB
    RegModel --> View : req
    deactivate RegModel

    View -> View : ตรวจ req.status != "pending"\n→ 400 "คำขอนี้ได้รับการพิจารณาแล้ว"
    View -> View : ตรวจ not req.username\n→ 400 "ข้อมูลเก่า ไม่มี username"
    View -> UserModel : User.objects.filter(\nusername=req.username).exists()
    activate UserModel
    UserModel -> DB : SELECT 1 FROM accounts_user\nWHERE username = ?
    activate DB
    DB --> UserModel : False (ยังไม่มี)
    deactivate DB
    UserModel --> View : exists = False
    deactivate UserModel

    View -> View : transaction.atomic()

    View -> UserModel : User(\nusername, full_name, address,\nphone, citizen_id, house_owner_name,\nprefix, birth_date,\nrole="user", verified=True,\nis_active=True)\nuser.password = req.password\nuser.save()
    activate UserModel
    UserModel -> DB : INSERT INTO accounts_user\n(username, full_name, ...\nrole="user", verified=True,\npassword=hashed)
    activate DB
    DB --> UserModel : user.id
    deactivate DB
    UserModel --> View : user object
    deactivate UserModel

    View -> RegModel : req.status = "approved"\nreq.save()
    activate RegModel
    RegModel -> DB : UPDATE accounts_registrationrequest\nSET status="approved"\nWHERE id = ?
    activate DB
    DB --> RegModel : updated
    deactivate DB
    RegModel --> View : saved
    deactivate RegModel

    View --> Page : 200 OK\n{"message": "อนุมัติสำเร็จ\nและสร้างบัญชีผู้ใช้แล้ว",\n"username": ..., "user_id": ...}
    deactivate View

    Page -> Page : target.status = 'approved'\n(อัปเดต local state)\ncloseModal()
    Page --> Admin : alert "✅ อนุมัติเรียบร้อย\nและสร้างบัญชีผู้ใช้แล้ว"

else [Admin กดปฏิเสธ]

    Admin -> Page : กดปุ่ม "✕ ปฏิเสธ"\n→ rejectUser(user)
    Page -> Page : รับ rejectReason\nจาก textarea / prompt

    Page -> URLs : axios.post(\n"/api/accounts/admin/requests/{id}/reject/",\n{reason}, {headers: {Authorization: Bearer token}})
    activate URLs

    URLs -> View : route /requests/{pk}/reject/\n→ request_reject()
    deactivate URLs
    activate View

    View -> View : ตรวจ role / หาคำขอ\n/ ตรวจ status = pending
    View -> RegModel : req.status = "rejected"\nreq.save()
    activate RegModel
    RegModel -> DB : UPDATE accounts_registrationrequest\nSET status="rejected"\nWHERE id = ?
    activate DB
    DB --> RegModel : updated
    deactivate DB
    RegModel --> View : saved
    deactivate RegModel

    View --> Page : 200 OK\n{"message": "ปฏิเสธสำเร็จ"}
    deactivate View

    Page -> Page : target.status = 'rejected'\n(อัปเดต local state)\ncloseModal()
    Page --> Admin : alert "❌ ปฏิเสธคำร้องเรียบร้อย"

end

deactivate Page

@enduml
