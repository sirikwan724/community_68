@startuml
scale 2
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam BoxPadding 12
skinparam defaultFontSize 12
skinparam defaultFontName Tahoma
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 5

title Flow 2A — Register Request (User ส่งคำขอสมัคร)

actor "ผู้ใช้งาน\n(User)" as User

box "Frontend (Vue)" #EBF5FB
    participant "RegisterRequest\nPage.vue" as Page
    participant "router\n/index.js" as Router
end box

box "Backend (Django REST Framework)" #EAF7EA
    participant "accounts\n/urls.py" as URLs
    participant "register_request\n(views.py)" as View
    participant "RegistrationRequest\nSerializer\n(serializers.py)" as Serial
    participant "RegistrationRequest\n(models.py)" as RegModel
    participant "User\n(models.py)" as UserModel
end box

database "Database\n(PostgreSQL)" as DB

== User ส่งคำขอสมัครสมาชิก ==

User -> Page : กรอกข้อมูลและกดปุ่ม\n"ส่งคำขอสมัครสมาชิก"
activate Page

Page -> Page : submitForm()\nเคลียร์ success / error

Page -> Page : ตรวจสอบอายุ (Client-side)\nคำนวณ age จาก birthDate

opt [อายุ < 18 ปี (Frontend)]
    Page --> User : แสดง error\n"ผู้สมัครต้องมีอายุ 18 ปีขึ้นไป"
end

Page -> URLs : axios.post(\n"/api/accounts/register-request/",\n{prefix, full_name, phone, address,\ncitizen_id, house_owner_name,\nbirth_date, username, password})
activate URLs

URLs -> View : route /register-request/\n→ register_request()
deactivate URLs
activate View

View -> Serial : RegistrationRequestSerializer(\ndata=request.data)
activate Serial

Serial -> Serial : validate_username(value)\nตรวจ username ซ้ำ

Serial -> UserModel : User.objects.filter(\nusername=value).exists()
activate UserModel
UserModel -> DB : SELECT 1 FROM accounts_user\nWHERE username = ?
activate DB
DB --> UserModel : True / False
deactivate DB
UserModel --> Serial : exists result
deactivate UserModel

alt [username ซ้ำ]
    Serial --> View : raise ValidationError\n"ชื่อผู้ใช้งานนี้ถูกใช้แล้ว"
    View --> Page : 400 Bad Request\n{username: ["ชื่อผู้ใช้งานนี้ถูกใช้แล้ว"]}
    Page --> User : แสดง error (username ซ้ำ)
else [username ยังไม่มี]
    Serial -> Serial : validate_birth_date(value)\nตรวจสอบอายุ >= 18 (Backend)

    alt [อายุ < 18 ปี (Backend)]
        Serial --> View : raise ValidationError\n"ผู้สมัครต้องมีอายุ 18 ปีขึ้นไป"
        View --> Page : 400 Bad Request\n{birth_date: ["..."]}
        Page --> User : แสดง error (อายุไม่ถึง)
    else [ข้อมูลถูกต้องทั้งหมด]
        Serial -> Serial : is_valid() → True

        Serial -> Serial : create(validated_data)\nmake_password(raw_password)\n→ hash รหัสผ่าน

        Serial -> RegModel : RegistrationRequest.objects.create(\n{...data, password=hashed,\nstatus="pending"})
        activate RegModel
        RegModel -> DB : INSERT INTO accounts_registrationrequest\n(username, full_name, phone, ...\npassword=hashed, status="pending")
        activate DB
        DB --> RegModel : saved record
        deactivate DB
        RegModel --> Serial : registration_request object
        deactivate RegModel

        Serial --> View : serializer.data
        deactivate Serial

        View --> Page : 201 Created\n{"message": "ส่งคำขอสมัครสำเร็จ\nรอผู้ใหญ่บ้านอนุมัติ"}
        deactivate View

        Page -> Page : success = "ส่งคำขอสมัครสำเร็จ! รอผลอนุมัติ"\nsetTimeout(1500ms)

        Page -> Router : router.push("/")
        activate Router
        Router --> User : redirect ไปหน้าแรก /
        deactivate Router
    end
end

deactivate Page

@enduml
